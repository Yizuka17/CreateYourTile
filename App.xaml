<Application x:Class="CreateYourTile.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf reads the Windows app theme and accent color when both overrides are null. -->
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Keep the Fluent visuals, while matching the larger hit targets and
                 direct-manipulation behavior expected from a touch-first Windows app. -->
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            </Style>

            <Style x:Key="TouchAccentButtonStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewerStyle}">
                <Setter Property="PanningMode" Value="VerticalOnly" />
                <Setter Property="PanningRatio" Value="1" />
                <Setter Property="PanningDeceleration" Value="0.001" />
                <Setter Property="IsDeferredScrollingEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource DefaultListBoxStyle}">
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
                <Setter Property="ScrollViewer.PanningRatio" Value="1" />
                <Setter Property="ScrollViewer.PanningDeceleration" Value="0.001" />
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
            </Style>

            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
