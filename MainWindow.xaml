<Window x:Class="CreateYourTile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="CreateYourTile!" Width="1160" Height="800"
        MinWidth="720" MinHeight="680" WindowStartupLocation="CenterScreen"
        SizeChanged="MainWindow_SizeChanged"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
        Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="CreateYourTile!" Style="{StaticResource SubheaderTextBlockStyle}" FontSize="38" />
            <TextBlock Text="在 Windows 10 创建并固定 Live Tile" Margin="0,2,0,0"
                       Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" FontSize="14" />
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PreviewContentRow" Height="*" />
                <RowDefinition x:Name="ResponsiveGapRow" Height="0" />
                <RowDefinition x:Name="SettingsContentRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="390" />
                <ColumnDefinition x:Name="LeftGapColumn" Width="30" />
                <ColumnDefinition x:Name="DividerColumn" Width="1" />
                <ColumnDefinition x:Name="RightGapColumn" Width="30" />
                <ColumnDefinition x:Name="SettingsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PreviewPanel" Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="预览" Style="{StaticResource TitleTextBlockStyle}" />

                <ScrollViewer x:Name="PreviewScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                              PanningRatio="1" PanningDeceleration="0.001">
                    <StackPanel Margin="0,0,12,0">
                        <Grid HorizontalAlignment="Center">
                        <Border x:Name="PreviewFrame" Width="300" Height="300" Background="#111111"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Image x:Name="PreviewImage" Stretch="Fill" />
                                <Border x:Name="PreviewNamePanel" VerticalAlignment="Bottom" Background="#99000000" Padding="12,9">
                                    <TextBlock x:Name="PreviewName" Text="磁贴名称" FontSize="15" FontWeight="SemiBold"
                                               Foreground="White" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock x:Name="EmptyImageHint" Text="选择一张图片后在这里预览"
                                           Foreground="#B5B5B5" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        </Grid>

                        <StackPanel Margin="0,20,0,0">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ChooseImageButton" Content="选择图片" Click="ChooseImageButton_Click" />
                            <TextBlock x:Name="ImagePathText" Grid.Column="2" Text="尚未选择" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="缩放" VerticalAlignment="Center" />
                            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="1" Maximum="4" Value="1"
                                    TickFrequency="0.1" ValueChanged="CropControl_Changed" />
                            <TextBlock x:Name="ZoomValue" Grid.Column="2" Text="1.0×" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="左右" VerticalAlignment="Center" />
                            <Slider x:Name="OffsetXSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0"
                                    TickFrequency="0.05" ValueChanged="CropControl_Changed" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上下" VerticalAlignment="Center" />
                            <Slider x:Name="OffsetYSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0"
                                    TickFrequency="0.05" ValueChanged="CropControl_Changed" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="ContentDivider" Grid.Row="0" Grid.Column="2" Width="1"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <Grid x:Name="SettingsPanel" Grid.Row="0" Grid.Column="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="磁贴设置" Style="{StaticResource TitleTextBlockStyle}" />

                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                                  PanningRatio="1" PanningDeceleration="0.001">
                        <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="名称" Margin="0,0,0,7" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBox x:Name="NameTextBox" TextChanged="NameTextBox_TextChanged" MaxLength="80" />

                        <TextBlock Text="打开类型" Margin="0,16,0,7" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                        <ComboBox x:Name="TargetKindComboBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="TargetKindComboBox_SelectionChanged">
                            <ComboBoxItem Content="程序或快捷方式" Tag="File" />
                            <ComboBoxItem Content="网址或 URI" Tag="Uri" />
                            <ComboBoxItem Content="Microsoft Store 应用 AUMID" Tag="AppId" />
                        </ComboBox>

                        <TextBlock Text="目标" Margin="0,16,0,7" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                        <StackPanel>
                            <TextBox x:Name="TargetTextBox" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="BrowseTargetButton" Content="选择文件…" Click="BrowseTargetButton_Click" />
                                <Button x:Name="BrowseFolderButton" Content="选择文件夹…" Margin="8,0,0,0"
                                        Click="BrowseFolderButton_Click" />
                                <Button x:Name="ChooseInstalledAppButton" Content="已安装应用…" Margin="8,0,0,0"
                                        Click="ChooseInstalledAppButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="TargetHelpText" Text="支持 C:、文件夹、文件、.exe、.lnk、.bat、.cmd 等本地目标。"
                                   Margin="0,6,0,0" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" />

                        <TextBlock Text="启动参数（可选）" Margin="0,16,0,7" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                        <TextBox x:Name="ArgumentsTextBox" />

                        <TextBlock Text="默认磁贴尺寸" Margin="0,16,0,7" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
                        <ComboBox x:Name="TileSizeComboBox" SelectedIndex="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="TileSizeComboBox_SelectionChanged">
                            <ComboBoxItem Content="小 (71 × 71)" Tag="Small" />
                            <ComboBoxItem Content="中 (150 × 150)" Tag="Medium" />
                            <ComboBoxItem Content="宽 (310 × 150)" Tag="Wide" />
                            <ComboBoxItem Content="大 (310 × 310)" Tag="Large" />
                        </ComboBox>

                        <CheckBox x:Name="ShowNameCheckBox" Content="在磁贴上显示名称" IsChecked="True" Margin="0,18,0,0"
                                  Checked="ShowNameCheckBox_Changed" Unchecked="ShowNameCheckBox_Changed" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="RegisterButton" Grid.Row="4" Content="注册并固定到“开始”"
                            Style="{StaticResource TouchAccentButtonStyle}" HorizontalAlignment="Left"
                            Click="RegisterButton_Click" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="Transparent" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="0,11,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
