<Window x:Class="CreateYourTile.InstalledAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="选择已安装应用" Width="760" Height="680" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
        Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="选择已安装应用" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="列表来自 Windows 的“应用程序”虚拟文件夹，包含桌面应用和 Store 应用。"
                       Margin="0,5,0,0" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />
        </StackPanel>

        <TextBox x:Name="SearchTextBox" Grid.Row="2" TextChanged="SearchTextBox_TextChanged"
                 ToolTip="按名称或启动目标搜索" />
        <TextBlock x:Name="CountText" Grid.Row="4" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" />

        <ListBox x:Name="AppListBox" Grid.Row="6" ScrollViewer.PanningMode="VerticalOnly"
                 ScrollViewer.PanningRatio="1" ScrollViewer.PanningDeceleration="0.001"
                 MouseDoubleClick="AppListBox_MouseDoubleClick" SelectionChanged="AppListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SystemControlPageTextBaseHighBrush}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Target}" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}"
                                       FontSize="11" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource SystemControlHighlightListAccentLowBrush}" Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" FontSize="10" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LoadStatusText" Foreground="{DynamicResource SystemControlPageTextBaseMediumBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="取消" MinWidth="88" IsCancel="True" />
            <Button x:Name="SelectButton" Grid.Column="3" Content="选择" MinWidth="88"
                    Style="{StaticResource TouchAccentButtonStyle}" IsDefault="True" IsEnabled="False"
                    Click="SelectButton_Click" />
        </Grid>
    </Grid>
</Window>
